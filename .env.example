# Which warehouse dbt / dashboard / notebook talk to: postgres (local) or snowflake
WAREHOUSE=postgres

# --- local Postgres (docker compose service `postgres`, host port 5433) ---
PGHOST=localhost
PGPORT=5433
PGUSER=fintech
PGPASSWORD=fintech
PGDATABASE=fintech

# --- Snowflake (only needed with WAREHOUSE=snowflake / --profile snowflake) ---
# Account identifier, e.g. myorg-myaccount (no .snowflakecomputing.com)
SNOWFLAKE_ACCOUNT=
# Loader (Kafka connector) key pair: see README "Snowflake mode"
SNOWFLAKE_PRIVATE_KEY_PATH=keys/rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# Transformer service user for dbt + dashboard + notebook (key-pair auth, created by setup.sql)
SNOWFLAKE_USER=FINTECH_DBT
SNOWFLAKE_DBT_PRIVATE_KEY_PATH=keys/dbt_key.p8
SNOWFLAKE_ROLE=FINTECH_TRANSFORMER
SNOWFLAKE_WAREHOUSE=FINTECH_WH
SNOWFLAKE_DATABASE=FINTECH
